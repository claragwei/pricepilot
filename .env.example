# No secrets are required for the core application.
# Copy to .env and fill in only if you enable optional services.
PRICEPILOT_DATA_DIR=data
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Local Postgres container (docker compose up -d); these defaults are for local development only.
# POSTGRES_USER=pricepilot
# POSTGRES_PASSWORD=pricepilot
# POSTGRES_DB=pricepilot
# POSTGRES_PORT=5433

# Snowflake trial: export these in your shell, never commit them.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
